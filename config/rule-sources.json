        {
          "op": "add",
          "sources": [
            {
              "url": "https://raw.githubusercontent.com/DustinWin/ruleset_geodata/mihomo-ruleset/google-cn.list",
              "format": "text"
            }
          ]
        },
        {
          "op": "prune-covered",
          "sources": [
            {
              "entries": [
                "+.cn"
              ]
            }
          ]
        }
      ]
    },
